# CivitasOne Suite — Environment variables template
# Copy to .env.local and fill values. NEVER commit .env.local to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Local/dev fallback connection string. In dev/test the PM2 ecosystem config
# (ecosystem.config.js) derives per-service dev credentials automatically, so
# this is only needed for tooling that reads DATABASE_URL directly.
DATABASE_URL=postgresql://civitasone:CHANGE_ME@localhost:5432/civitasone

# ── Production DB secrets (SEC-1 / SEC-2) ────────────────────────────────────
# In production (NODE_ENV=production) DB connection strings are NEVER derived
# from a dev-password pattern. The ecosystem config fails closed (refuses to
# start) unless one of the following is injected from the secret manager:
#   • DATABASE_URL                  — single connection string applied to every
#                                     service/worker that lacks a per-service var
#   • DATABASE_URL_<SVC>            — per-service override (takes precedence),
#                                     where <SVC> is the upper-cased service name
# Provide a dedicated, least-privilege connection string per service in prod.
# Examples (inject real values via the secret manager — do NOT commit them):
# DATABASE_URL_IDENTITY=postgresql://identity_svc:CHANGE_ME@db-host:5432/civitas_identity
# DATABASE_URL_TENANT=postgresql://tenant_svc:CHANGE_ME@db-host:5432/civitas_tenant
# DATABASE_URL_POLICY=postgresql://policy_svc:CHANGE_ME@db-host:5432/civitas_policy
# DATABASE_URL_AUDIT=postgresql://audit_svc:CHANGE_ME@db-host:5432/civitas_audit
# DATABASE_URL_FINANCE=postgresql://finance_svc:CHANGE_ME@db-host:5432/civitas_finance
# DATABASE_URL_PROCUREMENT=postgresql://procurement_svc:CHANGE_ME@db-host:5432/civitas_procurement
# DATABASE_URL_HRMS=postgresql://hrms_svc:CHANGE_ME@db-host:5432/civitas_hrms
# DATABASE_URL_PAYROLL=postgresql://payroll_svc:CHANGE_ME@db-host:5432/civitas_payroll
# DATABASE_URL_GRANT=postgresql://grant_svc:CHANGE_ME@db-host:5432/civitas_grant
# DATABASE_URL_CITIZEN=postgresql://citizen_svc:CHANGE_ME@db-host:5432/civitas_citizen
# DATABASE_URL_PROJECT=postgresql://project_svc:CHANGE_ME@db-host:5432/civitas_project
# DATABASE_URL_ASSET=postgresql://asset_svc:CHANGE_ME@db-host:5432/civitas_asset
# DATABASE_URL_STOCK=postgresql://stock_svc:CHANGE_ME@db-host:5432/civitas_stock
# DATABASE_URL_ESTAB=postgresql://estab_svc:CHANGE_ME@db-host:5432/civitas_estab
# DATABASE_URL_CONTRACT=postgresql://contract_svc:CHANGE_ME@db-host:5432/civitas_contract
# DATABASE_URL_CRM=postgresql://crm_svc:CHANGE_ME@db-host:5432/civitas_crm
# DATABASE_URL_LEGAL=postgresql://legal_svc:CHANGE_ME@db-host:5432/civitas_legal
# DATABASE_URL_ADMIN=postgresql://admin_svc:CHANGE_ME@db-host:5432/civitas_admin
# DATABASE_URL_BILLING=postgresql://billing_svc:CHANGE_ME@db-host:5432/civitas_billing
# DATABASE_URL_INVENTORY=postgresql://inventory_svc:CHANGE_ME@db-host:5432/civitas_inventory
# DATABASE_URL_TELEPHONY=postgresql://telephony_svc:CHANGE_ME@db-host:5432/civitas_telephony
# DATABASE_URL_HELPDESK=postgresql://helpdesk_svc:CHANGE_ME@db-host:5432/civitas_helpdesk
# DATABASE_URL_NOTIFICATION=postgresql://notification_svc:CHANGE_ME@db-host:5432/civitas_notification
# DATABASE_URL_REPORT=postgresql://report_svc:CHANGE_ME@db-host:5432/civitas_report
# DATABASE_URL_PLUGIN=postgresql://plugin_svc:CHANGE_ME@db-host:5432/civitas_plugin
# DATABASE_URL_THEME=postgresql://theme_svc:CHANGE_ME@db-host:5432/civitas_theme
# DATABASE_URL_INSTALL=postgresql://install_svc:CHANGE_ME@db-host:5432/civitas_install
# DATABASE_URL_KNOWLEDGE=postgresql://knowledge_svc:CHANGE_ME@db-host:5432/civitas_knowledge
# DATABASE_URL_WORKFLOW=postgresql://workflow_svc:CHANGE_ME@db-host:5432/civitas_workflow
# DATABASE_URL_ANALYTICS=postgresql://analytics_svc:CHANGE_ME@db-host:5432/civitas_analytics
# DATABASE_URL_LOCATION=postgresql://location_svc:CHANGE_ME@db-host:5432/civitas_location
# DATABASE_URL_IDENTITY... (one per service; see ecosystem.config.js for the full list)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=civitasone
KEYCLOAK_CLIENT_ID=civitasone-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── Queue (SQS via LocalStack dev / real AWS prod) ───────────────────────────
# QUEUE_DRIVER=memory  — in-process (tests only)
# QUEUE_DRIVER=sqs     — SQS (LocalStack locally, real AWS in prod)
QUEUE_DRIVER=sqs
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Object storage (S3 via LocalStack dev / real AWS prod) ───────────────────
AWS_S3_BUCKET=civitasone

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=CHANGE_ME

# ── Service ports ─────────────────────────────────────────────────────────────
IDENTITY_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
POLICY_SERVICE_PORT=3003
AUDIT_SERVICE_PORT=3004
INSTALL_SERVICE_PORT=3005
QUEUE_SERVICE_PORT=3000
NOTIFICATION_SERVICE_PORT=3006
FINANCE_SERVICE_PORT=3007
PROCUREMENT_SERVICE_PORT=3008
INVENTORY_SERVICE_PORT=3009
ASSET_SERVICE_PORT=3010
PROJECT_SERVICE_PORT=3011
HRMS_SERVICE_PORT=3012
CRM_SERVICE_PORT=3013
HELPDESK_SERVICE_PORT=3014
TELEPHONY_SERVICE_PORT=3015
REPORT_SERVICE_PORT=3016
PLUGIN_SERVICE_PORT=3017
THEME_SERVICE_PORT=3018

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated origins for production. Leave empty for dev (allows all).
CORS_ORIGIN=https://app.civitasone.gov.in,https://admin.civitasone.gov.in

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_SERVICE_NAME=civitasone
