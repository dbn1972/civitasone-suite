# CivitasOne Suite — Environment variables template
# Copy to .env.local and fill values. NEVER commit .env.local to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://civitasone:CHANGE_ME@localhost:5432/civitasone

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Keycloak / OIDC ──────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=civitasone
KEYCLOAK_CLIENT_ID=civitasone-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ── Queue (SQS via LocalStack dev / real AWS prod) ───────────────────────────
# QUEUE_DRIVER=memory  — in-process (tests only)
# QUEUE_DRIVER=sqs     — SQS (LocalStack locally, real AWS in prod)
QUEUE_DRIVER=sqs
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Object storage (S3 via LocalStack dev / real AWS prod) ───────────────────
AWS_S3_BUCKET=civitasone

# ── Meilisearch ──────────────────────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=CHANGE_ME

# ── Service ports ─────────────────────────────────────────────────────────────
IDENTITY_SERVICE_PORT=3001
TENANT_SERVICE_PORT=3002
POLICY_SERVICE_PORT=3003
AUDIT_SERVICE_PORT=3004
INSTALL_SERVICE_PORT=3005
QUEUE_SERVICE_PORT=3000
NOTIFICATION_SERVICE_PORT=3006
FINANCE_SERVICE_PORT=3007
PROCUREMENT_SERVICE_PORT=3008
INVENTORY_SERVICE_PORT=3009
ASSET_SERVICE_PORT=3010
PROJECT_SERVICE_PORT=3011
HRMS_SERVICE_PORT=3012
CRM_SERVICE_PORT=3013
HELPDESK_SERVICE_PORT=3014
TELEPHONY_SERVICE_PORT=3015
REPORT_SERVICE_PORT=3016
PLUGIN_SERVICE_PORT=3017
THEME_SERVICE_PORT=3018

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_SERVICE_NAME=civitasone
