# CivitasOne Web (Next.js)
NEXT_PUBLIC_APP_URL=https://civitasone.65-2-205-201.nip.io
NEXT_PUBLIC_API_BASE_URL=https://civitasone.65-2-205-201.nip.io/api
NEXT_PUBLIC_KEYCLOAK_ISSUER_URL=https://civitasone.65-2-205-201.nip.io/auth/realms/civitasone
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=civitasone-web
# Server uses the PUBLIC URL too (browser is redirected to this for login)
KEYCLOAK_ISSUER_URL=https://civitasone.65-2-205-201.nip.io/auth/realms/civitasone
KEYCLOAK_CLIENT_ID=civitasone-web
KEYCLOAK_REDIRECT_URI=https://civitasone.65-2-205-201.nip.io/api/auth/callback
CIVITASONE_API_BASE_URL=http://localhost:8080

# Dev-login demo password (dev/test only).
DEV_LOGIN_PASSWORD=change-me-dev-password

# Citizen apply flow: opt in to the fake-success TEST payment mode (never in production).
# Must match the server flag CITIZEN_PAYMENTS_SANDBOX_ENABLED. Leave unset/false otherwise.
NEXT_PUBLIC_CITIZEN_PAYMENTS_SANDBOX=false
