# CivitasOne Web (Next.js)
NEXT_PUBLIC_APP_URL=https://civitasone.65-2-205-201.nip.io
NEXT_PUBLIC_API_BASE_URL=https://civitasone.65-2-205-201.nip.io/api
NEXT_PUBLIC_KEYCLOAK_ISSUER_URL=https://civitasone.65-2-205-201.nip.io/auth/realms/civitasone
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=civitasone-web
# Server uses the PUBLIC URL too (browser is redirected to this for login)
KEYCLOAK_ISSUER_URL=https://civitasone.65-2-205-201.nip.io/auth/realms/civitasone
KEYCLOAK_CLIENT_ID=civitasone-web
KEYCLOAK_REDIRECT_URI=https://civitasone.65-2-205-201.nip.io/api/auth/callback
CIVITASONE_API_BASE_URL=http://localhost:8080

# Dev-login demo password (dev/test only).
DEV_LOGIN_PASSWORD=change-me-dev-password

# Citizen apply flow: opt in to the fake-success TEST payment mode (never in production).
# Must match the server flag CITIZEN_PAYMENTS_SANDBOX_ENABLED. Leave unset/false otherwise.
NEXT_PUBLIC_CITIZEN_PAYMENTS_SANDBOX=false

# GIGW 3.0 department identity and contacts (footer + GIGW public pages).
# Build-time, non-secret; read in src/lib/gigw/departmentConfig.ts. Set every
# value to what the Web Information Manager of the department has approved.
# Unset names show a labelled demonstration default; unset contact details show
# "To be configured before go-live" (never an invented address or number).
# Owning department (default: "CivitasOne Demonstration Department (UAT)"):
# NEXT_PUBLIC_GIGW_OWNER=
# Web Information Manager designation (default: "Web Information Manager,
# CivitasOne Demonstration Department"), e-mail and telephone:
# NEXT_PUBLIC_GIGW_WIM_DESIGNATION=
# NEXT_PUBLIC_GIGW_WIM_EMAIL=
# NEXT_PUBLIC_GIGW_WIM_PHONE=
# Postal address of the department:
# NEXT_PUBLIC_GIGW_ADDRESS=
# Help desk e-mail, telephone and working hours:
# NEXT_PUBLIC_GIGW_HELPDESK_EMAIL=
# NEXT_PUBLIC_GIGW_HELPDESK_PHONE=
# NEXT_PUBLIC_GIGW_HELPDESK_HOURS=
# Public Information Officer (RTI) designation and contact:
# NEXT_PUBLIC_GIGW_PIO_CONTACT=
# "Last reviewed" on the GIGW pages: date of the content review (YYYY-MM-DD);
# defaults to the build time.
# NEXT_PUBLIC_GIGW_REVIEWED_AT=
# Footer "Last updated" defaults to the build time; pin it with BUILD_TIME (ISO)
# or override it with an owner-approved content date:
# NEXT_PUBLIC_CONTENT_UPDATED_AT=YYYY-MM-DD
