{
  "name": "@civitasone/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e-report",
    "test:a11y": "playwright test --config tests/a11y/playwright.config.ts",
    "test:a11y:full": "A11Y_FULL=1 playwright test --config tests/a11y/playwright.config.ts",
    "test:a11y:baseline": "A11Y_BASELINE_WRITE=1 playwright test --config tests/a11y/playwright.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config tests/e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config tests/e2e/playwright.config.ts --debug"
  },
  "dependencies": {
    "@civitasone/auth": "workspace:*",
    "@civitasone/client-core": "workspace:*",
    "@civitasone/schemas": "workspace:*",
    "@civitasone/types": "workspace:*",
    "@civitasone/ui-kit": "workspace:*",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "reactflow": "11.11.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "14.3.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.0",
    "axe-core": "4.12.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "24.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  }
}
