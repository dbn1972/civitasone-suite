# CivitasOne Suite — production compose env template.
# Copy to infra/.env and fill REAL values (infra/.env is git-ignored).
#   cp infra/.env.prod.example infra/.env
# NEVER commit infra/.env. All values below are placeholders.

# ── Image registry / tag (optional; defaults to local "civitasone/*:latest") ──
IMAGE_REGISTRY=civitasone
IMAGE_TAG=latest

# ── Postgres ──
POSTGRES_USER=civitasone
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=civitasone

# ── Platform secrets (fail-closed: compose refuses to start if unset) ──
INTERNAL_SERVICE_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
DEVICE_TRUST_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM

# ── PII / MFA at-rest encryption keys (>=16 chars; rotate via secret mgr) ──
MFA_ENC_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM
PII_ENC_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM
CITIZEN_PII_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM
CRM_PII_KEY=CHANGE_ME_MIN_32_CHARS_RANDOM

# ── Keycloak ──
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KC_PASSWORD
KEYCLOAK_REALM=civitasone

# ── AWS / SQS (LocalStack defaults; set real creds for real AWS) ──
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=civitasone

# ── Networking ──
GATEWAY_PORT=8080
WEB_PORT=3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ── Optional per-service DB URLs (override the default; route via pgbouncer:6432) ──
# DATABASE_URL_IDENTITY=postgresql://identity_svc:pw@pgbouncer:6432/civitas_identity
