{
  "realm": "civitasone",
  "enabled": true,
  "displayName": "CivitasOne Suite",
  "displayNameHtml": "<strong>CivitasOne</strong> Suite",
  "loginTheme": "civitasone",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and passwordHistory(5)",
  "ssoSessionMaxLifespan": 28800,
  "ssoSessionIdleTimeout": 1800,
  "accessTokenLifespan": 1800,
  "accessTokenLifespanForImplicitFlow": 900,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,
  "accessCodeLifespan": 60,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Platform super-administrator (control plane)"
      },
      {
        "name": "tenant_admin",
        "description": "Tenant administrator \u2014 manages users and config"
      },
      {
        "name": "dept_head",
        "description": "Department head \u2014 approves, audits within dept"
      },
      {
        "name": "officer",
        "description": "Government officer \u2014 creates and processes records"
      },
      {
        "name": "auditor",
        "description": "Internal/external auditor \u2014 read-only + audit ops"
      },
      {
        "name": "citizen",
        "description": "Citizen \u2014 portal access only"
      },
      {
        "name": "service_account",
        "description": "Service-to-service machine identity"
      },
      {
        "name": "admin"
      },
      {
        "name": "audit_admin"
      },
      {
        "name": "audit_officer"
      },
      {
        "name": "budget_officer"
      },
      {
        "name": "citizen_officer"
      },
      {
        "name": "crm_admin",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "crm_user",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "data_principal"
      },
      {
        "name": "dept_officer"
      },
      {
        "name": "employee",
        "description": "Employee self-service (test role, minimal — added for role-coverage UX testing)"
      },
      {
        "name": "estab_officer"
      },
      {
        "name": "finance_admin"
      },
      {
        "name": "finance_officer"
      },
      {
        "name": "grievance_officer"
      },
      {
        "name": "hr_admin"
      },
      {
        "name": "hr_officer"
      },
      {
        "name": "inspection_admin"
      },
      {
        "name": "inspector"
      },
      {
        "name": "legal_admin"
      },
      {
        "name": "legal_officer"
      },
      {
        "name": "manager",
        "description": "Line manager (test role, minimal — added for role-coverage UX testing)"
      },
      {
        "name": "payroll_admin",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "payroll_officer",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "platform_admin"
      },
      {
        "name": "procurement_admin"
      },
      {
        "name": "procurement_officer"
      },
      {
        "name": "sales_officer",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "section_officer",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      },
      {
        "name": "works_admin",
        "description": "Created for Tier-1 RBAC audit 2026-08-20 — role was checked in service code but did not exist in Keycloak"
      }
    ]
  },
  "clients": [
    {
      "clientId": "civitasone-web",
      "name": "CivitasOne Web App",
      "description": "Next.js web application (public PKCE client)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://*.civitasone.gov.in/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://*.civitasone.gov.in"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenantId",
            "claim.name": "tid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "audience-account",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "account",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "civitasone-mobile",
      "name": "CivitasOne Mobile App",
      "description": "Flutter mobile application (public PKCE client)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "civitasone://auth/callback",
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenantId",
            "claim.name": "tid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "civitasone-services",
      "name": "CivitasOne Service Accounts",
      "description": "Confidential client for service-to-service M2M calls",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_SVC_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "civitasone-admin-cli",
      "name": "CivitasOne Admin CLI",
      "description": "Admin CLI for realm management scripts",
      "enabled": true,
      "publicClient": false,
      "secret": "${KEYCLOAK_ADMIN_CLI_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenantId",
            "claim.name": "tid",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [],
  "userFederationProviders": [],
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "hi"
  ],
  "defaultLocale": "en",
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xRobotsTag": "none",
    "xFrameOptions": "SAMEORIGIN",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
