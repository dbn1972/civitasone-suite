{
  "name": "civitasone-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "CivitasOne Suite — Unified Enterprise Suite for Government, PSU, and Small Offices",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:contract": "vitest run tests/contract/gateway.contract.test.ts",
    "test:screens": "vitest run tests/contract/screens.contract.test.ts",
    "screen-map": "node scripts/contract/screen-map.mjs",
    "verify-screens": "node scripts/contract/verify-screens.mjs",
    "verify:live": "bash scripts/dev/verify-live-stack.sh",
    "contract:score": "node scripts/contract/score.mjs",
    "qa:score": "node scripts/qa-readiness-score.mjs",
    "ci:check": "pnpm turbo typecheck lint test && pnpm exec vitest run tests/contract/gateway.contract.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
