{
  "name": "civitasone-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "CivitasOne Suite — Unified Enterprise Suite for Government, PSU, and Small Offices",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:all": "turbo run test",
    "test:services": "turbo run test --filter='./services/*'",
    "test:packages": "turbo run test --filter='./packages/*'",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:contract": "vitest run tests/contract/gateway.contract.test.ts tests/contract/cross-service-events.contract.test.ts",
    "test:contract:events": "vitest run tests/contract/cross-service-events.contract.test.ts",
    "test:contract:strict": "CONTRACT_STRICT=1 vitest run tests/contract/cross-service-events.contract.test.ts",
    "test:e2e:personas": "playwright test --config tests/e2e-personas/playwright.config.ts",
    "test:mutation": "npx stryker run",
    "contract:baseline": "BASELINE_WRITE=1 vitest run tests/contract/lib/baseline.test.ts",
    "test:integration": "vitest run tests/integration/",
    "test:screens": "vitest run tests/contract/screens.contract.test.ts",
    "screen-map": "node scripts/contract/screen-map.mjs",
    "verify-screens": "node scripts/contract/verify-screens.mjs",
    "verify:live": "bash scripts/dev/verify-live-stack.sh",
    "contract:score": "node scripts/contract/score.mjs",
    "qa:score": "node scripts/qa-readiness-score.mjs",
    "arch:guard": "node scripts/ci/arch-guard.mjs",
    "test:e2e-live": "playwright test --config tests/e2e-live/playwright.config.ts",
    "ci:check": "pnpm turbo typecheck lint test && pnpm exec vitest run tests/contract/gateway.contract.test.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "8.6.0",
    "@stryker-mutator/typescript-checker": "8.6.0",
    "@stryker-mutator/vitest-runner": "8.6.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "fast-check": "4.8.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
