{
  "name": "@civitasone/db",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./perf": {
      "import": "./dist/perf.js",
      "types": "./dist/perf.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "@civitasone/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "drizzle-kit": "^0.20.0",
    "vitest": "^2.0.0"
  }
}
