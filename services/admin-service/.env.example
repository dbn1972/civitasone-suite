# admin-service — copy to .env and adjust for your environment
PORT=3022
HOST=0.0.0.0
DATABASE_URL=postgres://admin_svc:admin_dev_pw@localhost:5435/civitas_admin
# Cross-tenant sftp lead-ingestion discovery (migration 0030 scanner role).
# In production this MUST point at the admin_scanner role, not admin_svc.
ADMIN_SCANNER_DATABASE_URL=postgres://admin_scanner:admin_scanner_dev_pw@localhost:5435/civitas_admin
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
