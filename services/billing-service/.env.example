# billing-service — copy to .env and adjust for your environment
PORT=3023
HOST=0.0.0.0
DATABASE_URL=postgres://billing_svc:billing_dev_pw@localhost:5435/civitas_billing
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# ── Multi-Gateway Payment Adapter ─────────────────────────────────
# Active gateway: razorpay | payu | ccavenue
PAYMENT_GATEWAY=razorpay
PAYMENT_TIMEOUT_MS=10000

# Razorpay credentials
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# PayU credentials
# PAYU_MERCHANT_KEY=your-payu-merchant-key
# PAYU_SALT=your-payu-salt
# PAYU_BASE_URL=https://sandboxsecure.payu.in

# CCAvenue credentials
# CCAVENUE_MERCHANT_ID=your-ccavenue-merchant-id
# CCAVENUE_ACCESS_CODE=your-ccavenue-access-code
# CCAVENUE_WORKING_KEY=your-ccavenue-working-key
# CCAVENUE_BASE_URL=https://test.ccavenue.com

# ── UPI Autopay (env-gated) ───────────────────────────────────────
PAYMENT_UPI_ENABLED=false
# UPI_AUTOPAY_BASE_URL=https://upi-provider.example.com
# UPI_AUTOPAY_API_KEY=your-upi-api-key

# ── e-Mandate (env-gated) ─────────────────────────────────────────
PAYMENT_EMANDATE_ENABLED=false
# EMANDATE_BASE_URL=https://emandate-provider.example.com
# EMANDATE_API_KEY=your-emandate-api-key
