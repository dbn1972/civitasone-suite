# citizen-service — copy to .env and adjust for your environment
PORT=3020
HOST=0.0.0.0
DATABASE_URL=postgres://citizen_svc:citizen_dev_pw@localhost:5435/civitas_citizen
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# P0-1/P0-6 (DPDP): field-level PII encryption at rest. CITIZEN_PII_KEY is REQUIRED
# (>=16 chars) — the service fails fast at boot if it is unset. Inject from the
# secret manager and PRESERVE it across restarts (rotating it without a keyring
# entry makes existing ciphertext undecryptable).
CITIZEN_PII_KEY=dev_pii_master_key_change_me_32chars
# Optional but recommended: dedicated KDF salt (falls back to a fixed app salt).
CITIZEN_PII_SALT=civitas-citizen-pii
