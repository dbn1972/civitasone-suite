# contract-service — copy to .env and adjust for your environment
PORT=3009
HOST=0.0.0.0
DATABASE_URL=postgres://contract_svc:contract_dev_pw@localhost:5435/civitas_contract
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# Cross-tenant outbox relay/purge scanner (BYPASSRLS). Falls back to DATABASE_URL
# in dev; MUST be set to a distinct contract_scanner DSN in production
# (see migrations/0015_contract_scanner_role.sql).
CONTRACT_SCANNER_DATABASE_URL=postgres://contract_scanner:contract_scanner_dev_pw@localhost:5435/civitas_contract
