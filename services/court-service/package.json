{
  "name": "@civitasone/court-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker-main.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@civitasone/auth": "workspace:*",
    "@civitasone/cache": "workspace:*",
    "@civitasone/circuit-breaker": "workspace:*",
    "@civitasone/db": "workspace:*",
    "@civitasone/events": "workspace:*",
    "@civitasone/observability": "workspace:*",
    "@civitasone/outbox": "workspace:*",
    "@civitasone/queue": "workspace:*",
    "@civitasone/render": "workspace:*",
    "@civitasone/schemas": "workspace:*",
    "@civitasone/search": "workspace:*",
    "@civitasone/storage": "workspace:*",
    "@civitasone/types": "workspace:*",
    "@fastify/cors": "9.0.1",
    "drizzle-orm": "0.30.10",
    "fastify": "4.29.1",
    "pdf-lib": "^1.17.1",
    "ioredis": "5.11.1",
    "pino": "8.21.0",
    "postgres": "3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.22.4",
    "vitest": "2.1.9",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "2.1.9"
  }
}
