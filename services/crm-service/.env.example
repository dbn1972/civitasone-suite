# crm-service — copy to .env and adjust for your environment
PORT=3024
HOST=0.0.0.0
DATABASE_URL=postgres://crm_svc:crm_dev_pw@localhost:5435/civitas_crm
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# PII encryption at rest (packages/crm-service/src/shared/pii-crypto.ts).
CRM_PII_KEY=dev_pii_master_key_change_me_32chars
CRM_PII_SALT=civitas-crm-pii
