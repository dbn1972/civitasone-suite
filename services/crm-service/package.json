{
  "name": "@civitasone/crm-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@civitasone/auth": "workspace:*",
    "@civitasone/cache": "workspace:*",
    "@civitasone/circuit-breaker": "workspace:*",
    "@civitasone/db": "workspace:*",
    "@civitasone/events": "workspace:*",
    "@civitasone/observability": "workspace:*",
    "@civitasone/outbox": "workspace:*",
    "@civitasone/queue": "workspace:*",
    "@civitasone/schemas": "workspace:*",
    "@civitasone/search": "workspace:*",
    "@civitasone/types": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "drizzle-orm": "^0.30.0",
    "fastify": "^4.27.0",
    "pino": "^8.21.0",
    "postgres": "^3.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.16.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "fast-check": "^4.8.0"
  }
}
