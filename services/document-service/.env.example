# document-service — copy to .env and adjust for your environment
PORT=3049
HOST=0.0.0.0
DATABASE_URL=postgres://document_svc:document_dev_pw@localhost:5435/civitas_document
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# Worker only (UAT F84): cross-tenant bulk-scan discovery DSN for the BYPASSRLS, read-only
# document_scanner role (migration 0007). REQUIRED outside development/test: document-worker
# refuses to start without it. Inject from the secret manager; never commit a real password.
# DOCUMENT_SCANNER_DATABASE_URL=postgres://document_scanner:<from-secret-manager>@localhost:5435/civitas_document
