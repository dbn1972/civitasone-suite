# finance-service — copy to .env and adjust for your environment
PORT=3007
HOST=0.0.0.0
DATABASE_URL=postgres://finance_svc:finance_dev_pw@localhost:5435/civitas_finance
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# PFMS Treasury Gateway (payment advice / payment status / salary bill /
# treasury balance — src/modules/pfms/pfms-client.ts). Leave all four unset
# to run in explicit SANDBOX mode: every response is clearly labeled
# `mode: "sandbox"` and every synthetic reference number is prefixed
# `SANDBOX-`, so it can never be mistaken for a real treasury transaction.
# Set PFMS_TREASURY_BASE_URL and PFMS_TREASURY_API_KEY together to switch to
# LIVE mode. This is a DIFFERENT integration from PFMS_ENABLED / PFMS_BASE_URL
# / PFMS_API_KEY below (the e-Kuber generic payment adapter) — the two are
# configured independently.
# Base URL of the NIC PFMS treasury API (unset = sandbox mode)
PFMS_TREASURY_BASE_URL=
# API key / client id issued by NIC for the treasury API (unset = sandbox mode)
PFMS_TREASURY_API_KEY=
# Absolute path to the DSC (Digital Signature Certificate) PEM file used to sign
# payment-advice and salary-bill submissions. Required only in live mode, and
# only for the two submission operations (status/balance lookups are unsigned).
PFMS_TREASURY_DSC_CERT_PATH=
# Passphrase for the DSC private key above. Never logged — see pfms-client.ts.
PFMS_TREASURY_DSC_CERT_PASSPHRASE=

# PFMS/e-Kuber generic payment adapter (src/modules/pfms/adapter.ts) — a
# separate integration from PFMS_TREASURY_* above. "true" to activate;
# anything else (including unset) fails closed.
# PFMS_ENABLED=true
# PFMS_BASE_URL=
# PFMS_API_KEY=

# ── Deployment mode (fail-closed) ───────────────────────────────────────────
# PFMS signing / release and the worker's start-up checks treat a deployment as PRODUCTION unless it is explicitly a
# sandbox. Sandbox behaviour (mock DSC signer, mock signatures accepted, an unconfigured SFTP gateway counted as "sent",
# no scanner role required) is an allowlist:
#   NODE_ENV=development | test           -> sandbox
#   anything else (production, staging, prod, unset, a typo) -> PRODUCTION
# So for local dev set NODE_ENV=development explicitly. A non-production environment that needs another NODE_ENV (for
# example staging) can opt in with PFMS_SANDBOX=true. PFMS_SANDBOX is REFUSED when NODE_ENV=production.
NODE_ENV=development
# PFMS_SANDBOX=true

# Cross-tenant outbox relay / purge (worker only). In a production deployment the worker REFUSES TO START unless this is
# set to the finance_scanner (BYPASSRLS) role's connection string AND differs from DATABASE_URL. Not needed in a sandbox
# (it falls back to DATABASE_URL).
# FINANCE_SCANNER_DATABASE_URL=postgres://finance_scanner:<password>@localhost:5435/civitas_finance

# Release sweeper: a PFMS release stuck in `processing` longer than this many minutes is moved to the operator-visible
# `send_unknown` state (never auto-resent). Default 30.
# PFMS_RELEASE_STUCK_MINUTES=30
