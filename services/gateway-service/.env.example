# Gateway — unified API entry for web/mobile clients
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# JWT edge verification: "true" (default), "audit" (log-only), "off" (skip)
GATEWAY_JWT_EDGE_VERIFY=true

# Per-upstream circuit breaker + timeout
GATEWAY_UPSTREAM_TIMEOUT_MS=15000
GATEWAY_CB_FAILURE_THRESHOLD=5
GATEWAY_CB_RECOVERY_MS=15000

# Rate limiting
# GATEWAY_RATE_LIMIT_MAX=1000
# GATEWAY_RATE_LIMIT_TENANT_MAX=200

# Upstream overrides (defaults to 127.0.0.1:service-port)
# GATEWAY_IDENTITY_URL=http://127.0.0.1:3001
# GATEWAY_CITIZEN_URL=http://127.0.0.1:3020
