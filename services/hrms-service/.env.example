# hrms-service — copy to .env and adjust for your environment
PORT=3012
HOST=0.0.0.0
DATABASE_URL=postgres://hrms_svc:hrms_dev_pw@localhost:5435/civitas_hrms
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Workforce Core (SmartTransfer OS) — posting ledger write path.
# "true" enables the applyPosting writer (ST-M01-09) to persist into
# workforce_core.posting_ledger. Default (unset) = off; the schema and read
# models exist regardless (ST-M01-07). Parsed strictly: only "true" enables it.
# WORKFORCE_CORE_LEDGER_ENABLED=false

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
