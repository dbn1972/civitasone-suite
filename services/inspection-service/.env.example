# inspection-service — copy to .env and adjust for your environment
#
# Docker image is built from the shared root Dockerfile:
#   docker build -f Dockerfile \
#     --build-arg SERVICE=inspection-service \
#     --build-arg ENTRY=dist/index.js \
#     --build-arg PORT=3036 \
#     -t civitasone/inspection-service:latest .

PORT=3036
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL 16 — dedicated civitas_inspection)
DATABASE_URL=postgres://inspection_svc:inspection_dev_pw@localhost:5435/civitas_inspection
DATABASE_POOL_SIZE=20

# Queue (SQS in production, memory/rabbitmq locally)
QUEUE_DRIVER=memory

# Cache (Redis 7)
REDIS_URL=redis://localhost:6381
CACHE_DRIVER=memory
CACHE_TTL=60

# Object Storage (S3 / MinIO — evidence attachments)
S3_BUCKET_NAME=civitas-inspection
S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-south-1

# Cross-service HTTP (HRMS for inspector availability/conflict checks)
HRMS_SERVICE_URL=http://localhost:3012

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# Workflow service (for plan approval integration)
WORKFLOW_SERVICE_URL=http://localhost:3029

# Notification service (for inspector alerts)
NOTIFICATION_TOPIC=notification.send

# Cross-tenant outbox relay/purge scanner (BYPASSRLS). Falls back to DATABASE_URL
# in dev; MUST be set to a distinct inspection_scanner DSN in production
# (see migrations/0022_inspection_scanner_role.sql).
INSPECTION_SCANNER_DATABASE_URL=postgres://inspection_scanner:inspection_scanner_dev_pw@localhost:5435/civitas_inspection
