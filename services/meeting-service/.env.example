# meeting-service — copy to .env and adjust for your environment
#
# Docker image is built from the shared root Dockerfile:
#   docker build -f Dockerfile \
#     --build-arg SERVICE=meeting-service \
#     --build-arg ENTRY=dist/index.js \
#     --build-arg PORT=3033 \
#     -t civitasone/meeting-service:latest .
PORT=3033
HOST=0.0.0.0
DATABASE_URL=postgres://meeting_svc:meeting_dev_pw@localhost:5435/civitas_meeting
DATABASE_POOL_SIZE=20
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Object storage (S3 / MinIO) for agenda books, signed minutes, VC recordings
S3_BUCKET_NAME=civitas-meeting
S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-south-1

# Search (Meilisearch / OpenSearch) for decision/minutes knowledge base
SEARCH_DRIVER=memory

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# DPDP Act: field-level PII encryption at rest (AES-256-GCM). MEETING_PII_KEY is
# REQUIRED (>=16 chars) — the service fails fast at boot if it is unset. Inject
# from the secret manager and PRESERVE it across restarts (rotating it without a
# keyring entry makes existing ciphertext undecryptable).
MEETING_PII_KEY=dev_pii_master_key_change_me_32chars
# Optional but recommended: dedicated KDF salt (falls back to a fixed app salt).
MEETING_PII_SALT=civitas-meeting-pii
# Second-layer key for classified content (Confidential/Secret/Top_Secret).
MEETING_CLASSIFIED_KEY=dev_classified_key_change_me_32chars
