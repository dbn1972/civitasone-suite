# ml-service — Environment variables
# Copy to .env.local and fill values. NEVER commit .env.local to git.

# ── Service ───────────────────────────────────────────────────────────────────
PORT=3032
BIND_HOST=127.0.0.1
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ml_svc:ml_dev_pw@localhost:5435/civitas_ml

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381
CACHE_TTL=300

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_DRIVER=sqs
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Object Storage (S3 / MinIO) ──────────────────────────────────────────────
S3_BUCKET_NAME=civitasone-ml-models
AWS_S3_ENDPOINT=http://localhost:4566

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# In test: HS256 bypass with JWT_SECRET
# In production: RS256 via Keycloak JWKS
JWT_SECRET=your-secret-here
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=civitasone

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_ML_ENABLED=false
FEATURE_ML_TRAINING_ENABLED=false
FEATURE_ML_EXPERIMENTS_ENABLED=false

# ── Training Pipeline ─────────────────────────────────────────────────────────
ML_TRAINING_CRON=0 2 * * 0
ML_TRAINING_TIMEOUT_MS=1800000

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
OTEL_SERVICE_NAME=ml-service

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=
