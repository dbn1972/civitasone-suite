# notification-service — copy to .env and adjust for your environment
PORT=3006
HOST=0.0.0.0
DATABASE_URL=postgres://notification_svc:notification_dev_pw@localhost:5435/civitas_notification
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# ── Channel delivery adapters ───────────────────────────────────────────────

# Email: smtp (production) | stub (dev — accepts without sending)
NOTIFICATION_EMAIL_DRIVER=stub
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@civitasone.local

# In-app fan-out via Redis pub/sub channel notifications:{tenantId}:{userId}
REDIS_URL=redis://localhost:6379
# memory = in-process pub/sub (tests/local); redis = use REDIS_URL
NOTIFICATION_IN_APP_DRIVER=memory

# SMS — disabled by default; set twilio + credentials to enable (REST client TBD)
NOTIFICATION_SMS_DRIVER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp — disabled by default; set meta + credentials to enable (REST client TBD)
NOTIFICATION_WHATSAPP_DRIVER=stub
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=

# Push — disabled by default
NOTIFICATION_PUSH_DRIVER=stub
FIREBASE_SERVER_KEY=

# ── PII encryption at rest (DPDP Act 2023) ──────────────────────────────────
# REQUIRED (>=16 chars). Encrypts bounces.recipient, suppression_list.recipient,
# push_subscriptions.device_token/endpoint and inbound_auto_responses.sender via
# AES-256-GCM. The service fails closed (throws on first use) when unset.
# Inject from the secret manager — never commit a real key.
NOTIFICATION_PII_KEY=your-secret-here
# Optional: HKDF/scrypt salt. Changing it invalidates every existing ciphertext.
NOTIFICATION_PII_SALT=civitas-notification-pii
# Optional: key id stamped into the ciphertext envelope (default k1).
NOTIFICATION_PII_KEY_ID=k1
# Optional: retired keys, readable during rotation. JSON {"k0":"<old secret>"}.
NOTIFICATION_PII_KEYRING=

# Optional: soft-bounce suppression threshold (INT-12). Per-tenant setting in
# bounces.suppression_settings wins; this is the fallback. Default 5.
NOTIFICATION_SOFT_BOUNCE_THRESHOLD=5
