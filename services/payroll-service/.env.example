# payroll-service — copy to .env and adjust for your environment
PORT=3013
HOST=0.0.0.0
DATABASE_URL=postgres://payroll_svc:payroll_dev_pw@localhost:5435/civitas_payroll
# Cross-tenant maintenance scanner DSN (BYPASSRLS payroll_scanner role) — used
# ONLY by worker.ts's outbox relay (startRelay) + scheduled purge
# (startOutboxPurge) to scan _outbox.messages/_inbox.processed across ALL
# tenants. Falls back to DATABASE_URL in dev; MUST be set to a distinct
# payroll_scanner DSN in production (see migrations/0032_payroll_scanner_role.sql).
PAYROLL_SCANNER_DATABASE_URL=postgres://payroll_scanner:payroll_scanner_dev_pw@localhost:5435/civitas_payroll
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
