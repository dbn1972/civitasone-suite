# payroll-service — copy to .env and adjust for your environment
PORT=3013
HOST=0.0.0.0
DATABASE_URL=postgres://payroll_svc:payroll_dev_pw@localhost:5435/civitas_payroll
# Cross-tenant maintenance scanner DSN (BYPASSRLS payroll_scanner role) — used
# ONLY by worker.ts's outbox relay (startRelay) + scheduled purge
# (startOutboxPurge) to scan _outbox.messages/_inbox.processed across ALL
# tenants. Falls back to DATABASE_URL in dev; MUST be set to a distinct
# payroll_scanner DSN in production (see migrations/0032_payroll_scanner_role.sql).
PAYROLL_SCANNER_DATABASE_URL=postgres://payroll_scanner:payroll_scanner_dev_pw@localhost:5435/civitas_payroll
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# At-rest field encryption (AES-256-GCM, src/shared/pii-crypto.ts). REQUIRED:
# seals the DSC keystore passphrase + P12 (dsc-config) and PII columns. The
# service fails closed without it (boot refuses in NODE_ENV=production; any
# seal/open throws elsewhere). Inject from the secret manager; PM2 maps
# PAYROLL_PII_KEY -> PII_ENC_KEY (ecosystem.config.js).
PII_ENC_KEY=change-me-min-16-chars
# Optional: active key id written into new envelopes (default k1), KDF salt,
# and retired keys kept readable after rotation (JSON {"<keyid>":"<secret>"}).
# PII_KEY_ID=k2
# PII_ENC_SALT=
# PII_ENC_KEYRING={"k1":"old-secret-min-16-chars"}
# One-shot DSC backfill (scripts/backfill-dsc-secrets.mjs) needs a DSN that
# bypasses RLS on payroll.dsc_config (e.g. the migration owner):
# DSC_BACKFILL_DATABASE_URL=
# Rollout guard (default: allowed). After the backfill reports
# remainingUnsealed: 0, set to false so a plaintext DSC secret is refused.
# DSC_ALLOW_LEGACY_UNSEALED=false
