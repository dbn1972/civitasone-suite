# procurement-service — copy to .env and adjust for your environment
PORT=3008
HOST=0.0.0.0
DATABASE_URL=postgres://procurement_svc:procurement_dev_pw@localhost:5435/civitas_procurement
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# PII Encryption (required for vendor data at-rest encryption)
PII_ENC_KEY=your-pii-encryption-key-here
PII_KEY_ID=k1

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
