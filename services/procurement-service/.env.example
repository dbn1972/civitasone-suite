# procurement-service — copy to .env and adjust for your environment
PORT=3008
HOST=0.0.0.0
DATABASE_URL=postgres://procurement_svc:procurement_dev_pw@localhost:5435/civitas_procurement
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# PII Encryption (required for vendor data at-rest encryption)
PII_ENC_KEY=your-pii-encryption-key-here
PII_KEY_ID=k1

# Cross-tenant maintenance scanner DSN (worker.ts outbox relay + scheduled
# purge) — must authenticate as the BYPASSRLS `procurement_scanner` role
# (migration 0027_procurement_scanner_role.sql) and be DISTINCT from
# DATABASE_URL in production, since _outbox.messages/_inbox.processed are
# FORCE ROW LEVEL SECURITY (migration 0028_outbox_inbox_rls.sql) and the
# NOBYPASSRLS procurement_svc role would otherwise see zero cross-tenant rows.
# DATABASE_URL — acceptable ONLY in dev where the service connects as the
# RLS-inert superuser. Rotate the scanner password out-of-band from the secret
# manager: ALTER ROLE procurement_scanner PASSWORD '<from-secrets>';
PROCUREMENT_SCANNER_DATABASE_URL=postgres://procurement_scanner:procurement_scanner_dev_pw@localhost:5435/civitas_procurement

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
