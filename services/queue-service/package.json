{
  "name": "@civitasone/queue-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1073.0",
    "amqplib": "^0.10.4",
    "@civitasone/auth": "workspace:*",
    "@civitasone/types": "workspace:*",
    "@civitasone/events": "workspace:*",
    "@fastify/cors": "^9.0.0",
    "fastify": "^4.27.0",
    "@civitasone/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
