# smarttransfer-service — copy to .env and adjust for your environment
PORT=3086
BIND_HOST=127.0.0.1
DATABASE_URL=postgres://smarttransfer_svc:smarttransfer_dev_pw@localhost:5435/civitas_smarttransfer
# BYPASSRLS scanner DSN for the worker's outbox relay/purge (required in production)
SMARTTRANSFER_SCANNER_DATABASE_URL=postgres://smarttransfer_scanner:smarttransfer_scanner_dev_pw@localhost:5435/civitas_smarttransfer
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# In-service entitlement re-check (fails CLOSED): where to read the module
# composition projection for this tenant. Defaults to the admin-service.
GATEWAY_ADMIN_URL=http://127.0.0.1:3022
INTERNAL_SERVICE_SECRET=

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=<generate-a-random-32+-char-value>
