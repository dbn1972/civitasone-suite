# telephony-service — copy to .env and adjust for your environment
PORT=3026
HOST=0.0.0.0
DATABASE_URL=postgres://telephony_svc:telephony_dev_pw@localhost:5435/civitas_telephony
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# PII encryption at rest (src/shared/pii-crypto.ts).
TELEPHONY_PII_KEY=dev_pii_master_key_change_me_32chars
TELEPHONY_PII_SALT=civitas-telephony-pii

# Carrier integration (src/shared/carrier-adapter.ts) — "mock" needs no creds.
TELEPHONY_CARRIER=mock
