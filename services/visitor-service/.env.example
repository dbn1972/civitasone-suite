# visitor-service — copy to .env and adjust for your environment
#
# Docker image is built from the shared root Dockerfile:
#   docker build -f Dockerfile \
#     --build-arg SERVICE=visitor-service \
#     --build-arg ENTRY=dist/index.js \
#     --build-arg PORT=3035 \
#     -t civitasone/visitor-service:latest .
PORT=3035
HOST=0.0.0.0
DATABASE_URL=postgres://visitor_svc:visitor_dev_pw@localhost:5435/civitas_visitor
DATABASE_POOL_SIZE=20
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Cross-tenant maintenance scanner (BYPASSRLS) — REQUIRED IN PRODUCTION.
#
# visitor.* tables are FORCE ROW LEVEL SECURITY and the service connects as the
# least-privilege visitor_svc role (NOBYPASSRLS). The 9 scheduled workers (DPDP
# retention + right-to-erasure purge, no-show, overstay, nightly-aggregation,
# auto-reject, recurring-pass-expiry, waiting-reminder, device health-check,
# scan-image cleanup) must scan ALL tenants to find work — a bare cross-tenant
# SELECT as visitor_svc returns ZERO rows, so every one of those workers would
# silently no-op. They read through the dedicated `visitor_scanner` BYPASSRLS
# role (created by migration 0009_scanner_role.sql). The scanner is READ-ONLY;
# every write still runs on DATABASE_URL inside runWithTenant(tenantId, ...) so
# RLS re-checks each mutation.
#
# Set this to the visitor_scanner DSN in prod/CI. If UNSET it falls back to
# DATABASE_URL — acceptable ONLY in dev where the service connects as the
# RLS-inert superuser. Rotate the scanner password out-of-band from the secret
# manager: ALTER ROLE visitor_scanner PASSWORD '<from-secrets>';
VISITOR_SCANNER_DATABASE_URL=postgres://visitor_scanner:visitor_scanner_dev_pw@localhost:5435/civitas_visitor

# Object storage (S3 / MinIO) for visitor photos, scanned ID documents, badges
S3_BUCKET_NAME=civitas-visitor
S3_ENDPOINT=http://localhost:4566
S3_REGION=ap-south-1

# Search (Meilisearch / OpenSearch)
SEARCH_DRIVER=memory

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr

# DPDP Act: field-level PII encryption at rest (AES-256-GCM). VISITOR_PII_KEY is
# REQUIRED (>=16 chars) — the service fails fast at boot if it is unset. Inject
# from the secret manager and PRESERVE it across restarts (rotating it without a
# keyring entry makes existing ciphertext undecryptable).
VISITOR_PII_KEY=dev_visitor_pii_master_key_32chars
# Optional but recommended: dedicated KDF salt (falls back to a fixed app salt).
VISITOR_PII_SALT=civitas-visitor-pii
