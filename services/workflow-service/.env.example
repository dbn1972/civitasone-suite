# workflow-service — copy to .env and adjust for your environment
PORT=3029
HOST=0.0.0.0
DATABASE_URL=postgres://workflow_svc:workflow_dev_pw@localhost:5435/civitas_workflow
# Cross-tenant scanner role (see admin-service's ADMIN_SCANNER_DATABASE_URL for the
# equivalent pattern). In production this MUST point at the workflow_scanner role.
WORKFLOW_SCANNER_DATABASE_URL=postgres://workflow_scanner:workflow_scanner_dev_pw@localhost:5435/civitas_workflow
QUEUE_DRIVER=memory
CACHE_DRIVER=memory
CACHE_TTL=60

# Keycloak JWT (production)
KEYCLOAK_URL=http://civitasone-keycloak:8080
KEYCLOAK_REALM=civitasone
JWT_ALGORITHM=RS256

# Tests only — uncomment for local vitest without Keycloak:
# JWT_ALGORITHM=HS256
# JWT_SECRET=test_secret_for_civitasone_32chr
