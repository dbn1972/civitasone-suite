# works-service environment variables
PORT=3036
BIND_HOST=127.0.0.1

# Database
DATABASE_URL=postgres://works_svc:your-secret-here@localhost:5435/civitas_works


# Cross-tenant BYPASSRLS pool for the worker's outbox relay + scheduled purge
# (migrations 0012/0013, src/shared/scanner-db.ts). Falls back to DATABASE_URL
# in dev; MUST point at the works_scanner role in production/CI.
WORKS_SCANNER_DATABASE_URL=postgres://works_scanner:works_scanner_dev_pw@localhost:5435/civitas_works

# Auth (RS256 in production, HS256 for local dev/test)
JWT_ALGORITHM=RS256
KEYCLOAK_URL=http://localhost:8180
# JWT_SECRET=test_secret_for_civitasone_32chr  # only for HS256 dev/test

# Queue
QUEUE_DRIVER=sqs
# QUEUE_DRIVER=rabbitmq
# QUEUE_DRIVER=memory

# Cache
CACHE_DRIVER=redis
REDIS_URL=redis://localhost:6381
CACHE_TTL=60

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
NODE_ENV=development
