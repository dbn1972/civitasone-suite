{
  "name": "@civitasone/works-service",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@civitasone/auth": "workspace:*",
    "@civitasone/cache": "workspace:*",
    "@civitasone/db": "workspace:*",
    "@civitasone/events": "workspace:*",
    "@civitasone/observability": "workspace:*",
    "@civitasone/outbox": "workspace:*",
    "@civitasone/queue": "workspace:*",
    "@civitasone/schemas": "workspace:*",
    "@civitasone/types": "workspace:*",
    "@fastify/cors": "9.0.1",
    "drizzle-orm": "0.33.0",
    "fastify": "4.28.1",
    "pino": "9.4.0",
    "postgres": "3.4.9",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "3.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
